# Route 53 DNS-01 (Let's Encrypt). Caddy creates _acme-challenge TXT records only.
# Do not publish a public A/AAAA record for app.inhousecloudsolutions.com.
# IAM policy template (needs ListResourceRecordSets + ChangeResourceRecordSets):
#   route53-caddy-iam-policy.json
#
# Format: KEY=value (no spaces around =, no quotes unless part of the value)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Route 53 zone ID is set in Caddyfile (hosted_zone_id), not here

# Optional; used for ACME account registration
# CADDY_ACME_EMAIL=contact@inhousecloudsolutions.com
